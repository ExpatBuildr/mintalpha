# Copy to .env and fill in. Never commit .env.

# --- Modes ---------------------------------------------------------------
# X_SOURCE: mock (sample data, free) | x_api (official X API v2, paid per read)
X_SOURCE=mock
# TELEGRAM_MODE: mock (prints to console) | live (sends real messages)
TELEGRAM_MODE=mock

# --- X API (developer.x.com -> Projects & Apps -> your app -> Keys and tokens) --
X_BEARER_TOKEN=

# --- Telegram (create a bot with @BotFather; see README for the chat id) --
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional -------------------------------------------------------------
# LLM gap-filling (also set classifier.use_llm: true in config.yaml)
ANTHROPIC_API_KEY=
# MintAlpha phone app access token (required for the app's live mode).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MOBILE_API_TOKEN=
# Password for the dashboard (HTTP Basic auth, any username). Strongly recommended
# if the dashboard is reachable from anywhere but localhost.
DASHBOARD_TOKEN=
# Overrides
# RADAR_DB_PATH=data/radar.db
# RADAR_CONFIG=config.yaml
# DISPLAY_TIMEZONE=Asia/Manila
# MOCK_DATA_PATH=sample_data/mock_posts.json
